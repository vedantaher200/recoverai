# Backend: use SQLite locally; use a managed PostgreSQL connection string in production.
DATABASE_URL=sqlite:///./recoverai.db
# Production example: postgresql+psycopg://USER:PASSWORD@HOST:5432/DATABASE
APP_ENV=development
# Comma-separated browser origins allowed to call the API locally. Add your Vercel URL for a separate frontend deployment.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5176,http://127.0.0.1:5176

# Frontend: leave blank for same-origin Vercel /api requests; set this for a separately hosted API.
VITE_API_BASE_URL=
