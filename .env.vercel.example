# RecoverAI production environment for Vercel + Neon
#
# In Neon: Dashboard -> Connection Details -> select the pooled connection
# string, then replace the placeholder below. Do not commit a filled-in copy.
DATABASE_URL=postgresql://NEON_USER:NEON_PASSWORD@NEON_POOLED_HOST/NEON_DATABASE?sslmode=require

APP_ENV=production

# The frontend and API are deployed together at this address.
CORS_ORIGINS=https://recoverai-iota.vercel.app

# Do not add VITE_API_BASE_URL in Vercel for this same-origin deployment.
# When absent, the frontend calls /api directly.
